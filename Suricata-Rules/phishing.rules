# phishing.rules - Suricata network detections for phishing-driven activity
# Companion to the Wazuh/Sysmon endpoint rules (T1218.005, T1059.001, T1566, T1204).
# SIDs 1000001-1000999 are reserved for local rules.
# STATUS: written for lab use, NOT yet tested against live traffic. Validate before use:
#   sudo suricata -T -c /etc/suricata/suricata.yaml -S phishing.rules
# Defaults assume HOME_NET is your lab network (e.g. 192.168.56.0/24).

# T1218.005 / T1566: HTA file requested over HTTP (HTA files are run by mshta.exe)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"LAB PHISHING HTA file requested over HTTP"; flow:established,to_server; http.uri; content:".hta"; nocase; classtype:trojan-activity; metadata:mitre_technique_id T1218.005; sid:1000001; rev:1;)

# T1059.001: PowerShell making HTTP requests (download cradles such as Invoke-WebRequest)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"LAB PHISHING PowerShell user-agent in HTTP request"; flow:established,to_server; http.user_agent; content:"WindowsPowerShell"; nocase; classtype:trojan-activity; metadata:mitre_technique_id T1059.001; sid:1000002; rev:1;)

# T1566: GoPhish-style tracking parameter (rid=<7 alphanumeric characters>)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"LAB PHISHING GoPhish-style rid tracking parameter"; flow:established,to_server; http.uri; content:"rid="; pcre:"/[?&]rid=[A-Za-z0-9]{7}(&|$)/"; classtype:policy-violation; metadata:mitre_technique_id T1566; sid:1000003; rev:1;)

# T1566: credentials posted over cleartext HTTP (typical fake login page)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"LAB PHISHING Password field in cleartext HTTP POST"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"password="; nocase; classtype:policy-violation; metadata:mitre_technique_id T1566; sid:1000004; rev:1;)

# T1204.002: Windows executable (MZ header plus DOS stub text) downloaded over HTTP
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"LAB PHISHING Windows executable downloaded over HTTP"; flow:established,to_client; file.data; content:"MZ"; depth:2; content:"This program cannot be run in DOS mode"; distance:0; within:120; classtype:trojan-activity; metadata:mitre_technique_id T1204.002; sid:1000005; rev:1;)

# T1566: DNS lookup of a dynamic DNS domain (often used for phishing and payload hosting)
alert dns $HOME_NET any -> any any (msg:"LAB PHISHING DNS query for DuckDNS domain"; dns.query; content:".duckdns.org"; nocase; endswith; classtype:bad-unknown; metadata:mitre_technique_id T1566; sid:1000006; rev:1;)
alert dns $HOME_NET any -> any any (msg:"LAB PHISHING DNS query for dynamic DNS domain (hopto/ddns)"; dns.query; pcre:"/\.(hopto\.org|ddns\.net|zapto\.org)$/i"; classtype:bad-unknown; metadata:mitre_technique_id T1566; sid:1000007; rev:1;)
