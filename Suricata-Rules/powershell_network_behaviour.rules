# powershell_network_behaviour.rules - Suricata rules for the "what would change the verdict" cases
# From the Suspicious Process Investigation Lab (Section 7.2). That investigation found NO network or DNS
# activity from the PowerShell chain, which was one reason the verdict was "benign intent". These rules
# watch for the opposite: PowerShell reaching out, downloading, or sending data.
# Suricata cannot see process names, so these rules key on the PowerShell HTTP user-agent
# ("WindowsPowerShell/...", sent by Invoke-WebRequest / Invoke-RestMethod). Other download methods
# that send no such user-agent will be missed.
# STATUS: written for lab use, NOT tested against live traffic. Validate with:
#   sudo suricata -T -c /etc/suricata/suricata.yaml -S powershell_network_behaviour.rules
# SIDs 1000301+ avoid clashing with the other rule files (1000001-7, 1000101-7, 1000201-6).
# Cleartext HTTP only: HTTPS contents cannot be inspected without decryption.

# Helper (no alert): remember that this flow came from a PowerShell user-agent
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"LAB PSNET PowerShell user-agent seen (helper, no alert)"; flow:established,to_server; http.user_agent; content:"WindowsPowerShell"; nocase; flowbits:set,lab.ps.ua; flowbits:noalert; sid:1000301; rev:1;)

# T1105: PowerShell downloads a Windows executable (MZ header plus DOS stub text)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"LAB PSNET PowerShell downloaded a Windows executable"; flow:established,to_client; flowbits:isset,lab.ps.ua; file.data; content:"MZ"; depth:2; content:"This program cannot be run in DOS mode"; distance:0; within:120; classtype:trojan-activity; metadata:mitre_technique_id T1105; sid:1000302; rev:1;)

# T1105 / T1059: PowerShell requests a script or HTA file (ps1, hta, vbs, js, bat, cmd)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"LAB PSNET PowerShell requested a script or HTA file"; flow:established,to_server; http.user_agent; content:"WindowsPowerShell"; nocase; http.uri; pcre:"/\.(ps1|hta|vbs|js|bat|cmd)(\?|$)/i"; classtype:trojan-activity; metadata:mitre_technique_id T1105; sid:1000303; rev:1;)

# T1071.001: PowerShell talks to a raw IP address instead of a domain name
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"LAB PSNET PowerShell HTTP request to a raw IP address"; flow:established,to_server; http.user_agent; content:"WindowsPowerShell"; nocase; http.host; pcre:"/^\d{1,3}(\.\d{1,3}){3}(:\d+)?$/"; classtype:bad-unknown; metadata:mitre_technique_id T1071.001; sid:1000304; rev:1;)

# T1571: PowerShell HTTP to a non-standard port (not 80 or 443)
alert http $HOME_NET any -> $EXTERNAL_NET ![80,443] (msg:"LAB PSNET PowerShell HTTP request on a non-standard port"; flow:established,to_server; http.user_agent; content:"WindowsPowerShell"; nocase; classtype:bad-unknown; metadata:mitre_technique_id T1571; sid:1000305; rev:1;)

# T1041: PowerShell sends data out with an HTTP POST (possible exfiltration or C2 check-in)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"LAB PSNET PowerShell HTTP POST to external host"; flow:established,to_server; http.method; content:"POST"; http.user_agent; content:"WindowsPowerShell"; nocase; classtype:policy-violation; metadata:mitre_technique_id T1041; sid:1000306; rev:1;)
