# Suricata lab rules, SIDs 9000001-9000014. One rule per line.
alert http any any -> $HOME_NET any (msg:"LAB Suspicious URI test"; flow:established,to_server; http.uri; content:"/lab-test-ids"; nocase; sid:9000001; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"LAB Possible port scan"; flags:S; threshold:type both, track by_src, count 20, seconds 5; sid:9000002; rev:1;)
alert tcp any any -> $HOME_NET 22 (msg:"LAB SSH brute force attempt"; flags:S; threshold:type both, track by_src, count 5, seconds 60; sid:9000003; rev:1;)
alert icmp any any -> $HOME_NET any (msg:"LAB ICMP ping sweep"; itype:8; threshold:type both, track by_src, count 5, seconds 10; sid:9000004; rev:1;)
alert http any any -> $HOME_NET any (msg:"LAB Directory traversal attempt"; flow:established,to_server; http.uri.raw; content:"../"; sid:9000005; rev:1;)
alert http any any -> $HOME_NET any (msg:"LAB Scanner user-agent"; flow:established,to_server; http.user_agent; content:"nikto"; nocase; sid:9000006; rev:1;)
drop http any any -> $HOME_NET any (msg:"LAB IPS drop directory traversal"; flow:established,to_server; http.uri.raw; content:"../"; sid:9000007; rev:1;)
alert http any any -> $HOME_NET any (msg:"LAB Nmap NSE user-agent"; flow:established,to_server; http.user_agent; content:"Nmap Scripting Engine"; sid:9000008; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"LAB Nmap NULL scan"; flags:0; threshold:type both, track by_src, count 10, seconds 5; sid:9000009; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"LAB Nmap Xmas scan"; flags:FPU,12; threshold:type both, track by_src, count 10, seconds 5; sid:9000010; rev:1;)
alert http any any -> $HOME_NET any (msg:"LAB SQL injection attempt"; flow:established,to_server; http.uri; content:"union"; nocase; content:"select"; nocase; distance:0; sid:9000011; rev:1;)
alert http any any -> $HOME_NET any (msg:"LAB XSS attempt"; flow:established,to_server; http.uri; content:"<script"; nocase; sid:9000012; rev:1;)
alert http any any -> $HOME_NET any (msg:"LAB passwd file access"; flow:established,to_server; http.uri; content:"/etc/passwd"; nocase; sid:9000013; rev:1;)
alert icmp any any -> $HOME_NET any (msg:"LAB ICMP echo request"; itype:8; sid:9000014; rev:1;)
