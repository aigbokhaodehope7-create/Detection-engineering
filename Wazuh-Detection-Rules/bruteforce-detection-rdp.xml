<!--
  Rules: 100700, 100701  (DRAFT — IDs not yet confirmed against real local_rules.xml)
  Project: RDP Brute Force Lab (INC-2026-001)
  Attack: Hydra RDP brute force against a Windows 10 victim

  This lab's incident report documents detection via Wazuh's BUILT-IN ruleset,
  not a dedicated custom rule:
    - 60122  Logon failure: unknown user or bad password (fires per Event ID 4625)
    - 60204  Multiple Windows logon failures (frequency-based, maps to T1110)
    - 60106  Windows logon success (used to correlate success-after-failure)

  ⚠️ Before deploying the rules below: confirm whether a custom correlation rule
  was actually written for this lab. If not, delete this file and rely on the
  built-ins above instead — don't deploy unconfirmed rule IDs that might clash
  with something already in local_rules.xml.
-->
<group name="windows,authentication,rdp,bruteforce,">

  <!--
    Rule: 100700 (DRAFT)
    Detects: 8+ failed RDP (logonType 10) logons from the same source in 2 minutes
    Why: Same pattern as the validated SMB brute force rule (100101), adapted to
         RDP's logon type (10 = RemoteInteractive instead of 3 = Network).
    MITRE ATT&CK: T1110.001 (Brute Force: Password Guessing)
    False positives: user mistyping a password; stale saved credential retrying
  -->
  <rule id="100700" level="12" frequency="8" timeframe="120">
    <if_matched_sid>60122</if_matched_sid>
    <field name="win.eventdata.logonType">10</field>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>Possible RDP brute force: 8+ failed logons from same source in 2 minutes</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <!--
    Rule: 100701 (DRAFT)
    Detects: A successful logon from a source that just triggered 100700
    Why: A successful logon immediately following a brute force burst from the
         same IP is a strong indicator the attack succeeded.
    MITRE ATT&CK: T1110 (Brute Force), T1078 (Valid Accounts)
    False positives: legitimate user succeeding after a few mistyped attempts
  -->
  <rule id="100701" level="15" timeframe="300">
    <if_sid>60106</if_sid>
    <if_matched_sid>100700</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>Successful logon after brute force from same source: possible account compromise</description>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
  </rule>

</group>
