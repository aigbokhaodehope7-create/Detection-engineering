<!--
  Rules: 100100, 100101
  Project: SMB Brute Force Lab (LAB-2026-002)
  Attack: CrackMapExec credential brute force against a domain-joined
          Windows Server 2019 host (HopeLabs.Local), target account HR-STAFF1
  Validated: Event ID 4625 (failed logon, type 3 / network) after fixing a
             Windows-side audit-policy gap (Logon/Logoff was set to No Auditing)
-->
<group name="windows,authentication,smb,bruteforce,">

  <!--
    Rule: 100100
    Detects: A failed network logon (SMB/remote authentication)
    Why: Narrows Wazuh's built-in failed-logon rule (60122) down to logonType 3
         (network logon), which is what SMB/remote authentication produces —
         keeps it from mixing in interactive console failures.
    MITRE ATT&CK: T1110.001 (Brute Force: Password Guessing)
    False positives: user mistyping a password once
  -->
  <rule id="100100" level="10">
    <if_sid>60122</if_sid>
    <field name="win.eventdata.logonType">3</field>
    <description>Windows Failed Login Detected</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <!--
    Rule: 100101
    Detects: 8+ failed network logons from the same source IP within 2 minutes
    Why: Correlates repeated 100100 hits from the same source, which is what
         distinguished the actual Hydra/CrackMapExec brute force from an
         isolated mistyped password during testing.
    MITRE ATT&CK: T1110.001 (Brute Force: Password Guessing)
    False positives: service/scheduled task retrying a stale credential;
                      vulnerability scanner hitting SMB
    Validated: fired on the re-run CrackMapExec attack from Kali (192.168.56.102)
               against HR-STAFF1 after the audit-policy fix
  -->
  <rule id="100101" level="12" frequency="8" timeframe="120">
    <if_matched_sid>100100</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>Multiple Windows Failed Logons Detected – Possible Brute Force</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

</group>
